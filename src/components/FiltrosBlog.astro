---
---
<div class="bg-white px-6 lg:px-16 pt-8 pb-4">

  <!-- Fila de filtros -->
  <div class="flex items-center justify-center gap-3 flex-wrap lg:flex-nowrap">
    <span class="font-sans font-bold text-black text-[14px] lg:text-[16px] whitespace-nowrap mr-2">Filtrar por:</span>

    <button class="bg-[#F8EF36] text-black font-sans font-semibold text-[13px] lg:text-[15px] px-5 py-2 rounded-full hover:opacity-80 transition-opacity">
      Todo
    </button>
    <button class="bg-[#945DA7] text-white font-sans font-semibold text-[13px] lg:text-[15px] px-5 py-2 rounded-full hover:opacity-80 transition-opacity">
      Maternidad
    </button>
    <button class="bg-[#A9CF38] text-white font-sans font-semibold text-[13px] lg:text-[15px] px-5 py-2 rounded-full hover:opacity-80 transition-opacity">
      Negocios
    </button>
    <button class="bg-[#E75F24] text-white font-sans font-semibold text-[13px] lg:text-[15px] px-5 py-2 rounded-full hover:opacity-80 transition-opacity">
      Productividad
    </button>
    <button class="bg-[#D4187D] text-white font-sans font-semibold text-[13px] lg:text-[15px] px-5 py-2 rounded-full hover:opacity-80 transition-opacity">
      Bienestar
    </button>
  </div>

  <!-- Línea naranja -->
  <div class="mt-4 h-[2px] bg-[#E75F24] w-full"></div>

</div>
