---
---
<section class="relative bg-[#945DA7] overflow-x-hidden">

  <!-- Vector 4 decorative swirl (background) -->
  <img
    src="/vector4.png"
    alt=""
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[140%] lg:w-[100%] opacity-60 z-0 pointer-events-none"
    aria-hidden="true"
  />

  <!-- Main hero content -->
  <div class="relative flex flex-col lg:flex-row lg:items-stretch">

    <!-- LEFT: Text column -->
    <div class="relative z-10 flex flex-col justify-center px-6 lg:px-[6%] pt-10 pb-2 lg:py-20 lg:w-[50%]">
      <h1 class="font-display text-center lg:text-left text-[38px] leading-[1.1] lg:text-[70px] lg:leading-[1.1] font-light text-white">
        Conecta tu marca con
        <span class="inline-block bg-[#E75F24] text-white px-3 py-0.5 rounded-lg mx-1 align-baseline">mamás</span>
        que deciden la compra.
      </h1>

      <p class="text-white mt-5 text-center lg:text-left text-[14px] lg:text-[20px] lg:leading-relaxed max-w-md lg:max-w-2xl">
        Nuestra comunidad no es un número <strong>son mujeres que investigan, comparan y compran para sus familias todos los días.</strong> Si tu marca les habla, este es el lugar donde te van a escuchar.
      </p>

      <div class="mt-7 lg:mt-8 flex items-center justify-center lg:justify-start gap-3">
        <a
          href="#propuesta"
          class="bg-white text-[#945DA7] font-sans text-[14px] lg:text-[16px] px-7 py-3 rounded-full hover:bg-[#945DA7] hover:text-white transition-colors"
        >
          Quiero enviar mi propuesta
        </a>
      </div>
    </div>

    <!-- RIGHT: Photo + blob -->
    <div class="relative lg:w-[50%] h-[520px] lg:h-auto lg:min-h-[85vh] overflow-visible">

      <!-- GRUPO: todos los elementos visuales -->
      <div class="absolute top-0 left-0 w-full h-full lg:scale-[1.3] lg:origin-top-left">

        <!-- SUBGRUPO: Nube verde + Lizseth + Flor + Badge -->
        <div class="absolute top-[20px] left-[30px] w-[610px] h-[500px] lg:translate-x-0 lg:top-[20px] lg:left-[-20px] lg:w-[640px] lg:h-[700px]">
          <img
            src="/nubeverde.png"
            alt=""
            class="absolute top-[20px] left-[-50px] w-[468px] lg:w-[623px] lg:left-[-23px] z-0"
            aria-hidden="true"
          />
          <img
            src="/lizseth_patrocinadores.png"
            alt="Lizseth Henao"
            class="absolute bottom-[7px] left-[-75px] w-[453px] lg:w-[580px] lg:bottom-[68px] lg:left-[-42px] object-contain object-bottom z-10"
          />
          <!-- Pink flower -->
          <img
            src="/flor_pink.png"
            alt=""
            class="absolute bottom-[60px] left-[-50px] w-[165px]
                   lg:bottom-[180px] lg:left-[-60px] lg:w-[230px] z-20"
            aria-hidden="true"
          />
          <!-- +15K badge -->
          <div class="absolute bottom-[80px] left-[240px] lg:bottom-[180px] lg:left-[360px] bg-[#F8EF36] rounded-xl px-5 py-3 z-20 text-center shadow-md -rotate-[15deg]">
            <p class="font-sans font-bold text-black text-[1.93rem] lg:text-[2.31rem] leading-none">+15K</p>
            <p class="font-sans text-black text-[0.85rem] lg:text-[1.1rem] leading-tight mt-0.5">Oyentes<br/>mensuales</p>
          </div>
        </div>

        <!-- White cloud -->
        <img
          src="/nube_blanca.png"
          alt=""
          class="absolute top-[70px] left-[45px] w-[70px] lg:top-[90px] lg:left-[50px] lg:w-[100px] z-20"
          aria-hidden="true"
        />

        <!-- Orange star burst -->
        <img
          src="/estrellanaranja.png"
          alt=""
          class="absolute top-[130px] left-[240px] w-[140px]
                 lg:top-[130px] lg:left-[370px] lg:w-[205px] z-20"
          aria-hidden="true"
        />

      </div>

    </div>
  </div>

  <!-- Nuestra audiencia de mamás -->
  <div class="relative flex items-center justify-center lg:justify-start pl-4 lg:pl-16 py-4 lg:py-6">
    <div class="bg-[#EA4798] rounded-full px-5 py-[7px] lg:px-9 lg:py-[10px] shrink-0 -translate-x-[10px] lg:translate-x-0 lg:ml-[140px] z-10 relative">
      <p class="font-display font-bold text-white text-[18px] lg:text-[45px] tracking-wider whitespace-nowrap">Nuestra audiencia de mamás</p>
    </div>
    <!-- Línea que sale del óvalo hacia la derecha -->
    <div class="absolute top-1/2 -translate-y-1/2 right-0 left-[55%] h-[3px] bg-[#EA4798] lg:hidden"></div>
    <div class="hidden lg:block flex-1 h-[3px] bg-[#EA4798]"></div>
  </div>

</section>
