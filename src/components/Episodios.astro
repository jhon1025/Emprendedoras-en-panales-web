---
const episodios = [
  { imagen: '/thumbnails1.png', titulo: 'Mamá y Empresaria' },
  { imagen: '/thumbnails2.png', titulo: 'Estoy en mi mejor momento' },
  { imagen: '/thumbnails3.png', titulo: 'Solo tenía 5to de primaria' },
];
---
<section class="bg-[#6A3A9F] py-8 px-5 relative pb-16">
  <div class="flex items-center gap-2 mb-6">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
      <path d="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3zm-1-9c0-.55.45-1 1-1s1 .45 1 1v6c0 .55-.45 1-1 1s-1-.45-1-1V5zm6 6c0 2.76-2.24 5-5 5s-5-2.24-5-5H5c0 3.53 2.61 6.43 6 6.92V21h2v-3.08c3.39-.49 6-3.39 6-6.92h-2z"/>
    </svg>
    <p class="text-white font-bold text-sm font-sans">
      Nuevos episodios <span class="underline">cada semana</span>
    </p>
  </div>

  <div class="space-y-4">
    {episodios.map((ep) => (
      <a href="#" class="block rounded-xl overflow-hidden shadow-lg">
        <img src={ep.imagen} alt={ep.titulo} class="w-full h-auto object-cover" />
      </a>
    ))}
  </div>

  <div class="text-center mt-8">
    <a href="#" class="text-white font-display text-sm underline underline-offset-4">
      Ver todos los episodios
    </a>
  </div>

  <svg class="absolute bottom-0 left-0 w-full" viewBox="0 0 390 55" preserveAspectRatio="none" fill="#E75F24">
    <path d="M0,55 L390,55 L390,40 Q357.5,0 325,40 Q292.5,0 260,40 Q227.5,0 195,40 Q162.5,0 130,40 Q97.5,0 65,40 Q32.5,0 0,40 Z"/>
  </svg>
</section>
