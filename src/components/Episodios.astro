---
const episodios = [
  { imagen: '/thumbnails1.png', titulo: 'Mamá y Empresaria' },
  { imagen: '/thumbnails2.png', titulo: 'Estoy en mi mejor momento' },
  { imagen: '/thumbnails3.png', titulo: 'Solo tenía 5to de primaria' },
];
---
<section class="reveal-target bg-[#945DA7] py-8 px-5 relative pb-16 rounded-tl-[3rem] rounded-tr-[3rem] lg:px-16 lg:py-12 lg:pb-20">

  <div class="flex items-center justify-between mb-6 lg:mb-6">
    <div class="flex items-center gap-2 lg:gap-2 lg:ml-16">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 lg:w-5 h-5 lg:h-5 text-white flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3zm-1-9c0-.55.45-1 1-1s1 .45 1 1v6c0 .55-.45 1-1 1s-1-.45-1-1V5zm6 6c0 2.76-2.24 5-5 5s-5-2.24-5-5H5c0 3.53 2.61 6.43 6 6.92V21h2v-3.08c3.39-.49 6-3.39 6-6.92h-2z"/>
      </svg>
      <p class="text-white font-bold text-sm font-sans lg:text-base">
        Nuevos episodios <span class="underline">cada semana</span>
      </p>
    </div>
    <a href="#" class="hidden lg:block text-white font-display text-sm lg:text-sm underline underline-offset-4 hover:text-white/80 transition-colors lg:mr-16">
      Ver todos los episodios
    </a>
  </div>

  <!-- Móvil: columna | Desktop: 3 en fila -->
  <div class="space-y-4 lg:space-y-0 lg:grid lg:grid-cols-3 lg:gap-10 lg:max-w-5xl lg:mx-auto lg:items-end">
    {episodios.map((ep, i) => (
      <a href="#" class={`block rounded-xl overflow-hidden shadow-lg hover:scale-[1.02] transition-transform ${i === 1 ? 'lg:-translate-y-6' : ''}`}>
        <img src={ep.imagen} alt={ep.titulo} class="w-full lg:w-full object-cover aspect-video" />
      </a>
    ))}
  </div>

  <div class="text-center mt-8 lg:mt-8 lg:hidden">
    <a href="#" class="text-white font-display text-sm lg:text-sm underline underline-offset-4">
      Ver todos los episodios
    </a>
  </div>

  <svg class="absolute bottom-0 lg:bottom-0 left-0 lg:left-0 w-full lg:w-full lg:h-8" viewBox="0 0 1440 60" preserveAspectRatio="none" fill="#E75F24">
    <path d="M0,60 L1440,60 L1440,45 C1410,0 1350,0 1320,45 C1290,0 1230,0 1200,45 C1170,0 1110,0 1080,45 C1050,0 990,0 960,45 C930,0 870,0 840,45 C810,0 750,0 720,45 C690,0 630,0 600,45 C570,0 510,0 480,45 C450,0 390,0 360,45 C330,0 270,0 240,45 C210,0 150,0 120,45 C90,0 30,0 0,45 Z"/>
  </svg>
</section>
