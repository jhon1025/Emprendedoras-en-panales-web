---
const marcas = [
  { src: '/pocion.png', alt: 'Poción' },
  { src: '/uconex.png', alt: 'Uconex' },
  { src: '/natmat.png', alt: 'Natmat' },
  { src: '/everydaylove.png', alt: 'Everyday Love' },
  { src: '/huellapura.png', alt: 'Huella Pura' },
  { src: '/hlala!beautybar.png', alt: 'Hlala Beauty Bar' },
  { src: '/diana.png', alt: 'Diana' },
  { src: '/cadu.png', alt: 'Cadu' },
  { src: '/casaraiz.png', alt: 'Casa Raiz' },
];
---
<footer>

  <!-- Logos de marcas -->
  <div class="bg-white py-8 px-5 lg:pt-20 lg:pb-12 lg:px-32">
    <!-- Móvil: scroll horizontal | Desktop: grid 2 filas centrado -->
    <div class="flex items-center gap-8 overflow-x-auto pb-2 lg:hidden" style="scrollbar-width: none;">
      {marcas.map((m) => (
        <img src={m.src} alt={m.alt} class="h-8 w-auto flex-shrink-0 grayscale opacity-60" />
      ))}
    </div>
    <div class="hidden lg:grid lg:grid-cols-5 lg:gap-x-16 lg:gap-y-8 lg:items-center lg:justify-items-center">
      {marcas.map((m) => (
        <img src={m.src} alt={m.alt} class="h-10 w-auto object-contain" />
      ))}
    </div>
  </div>

  <!-- Newsletter blob -->
  <div class="bg-white px-5 pt-2 pb-10 lg:pb-20 lg:px-16">
    <div class="relative text-white text-center lg:max-w-lg lg:mx-auto">
      <img
        src="/nuberosada.png"
        alt=""
        aria-hidden="true"
        class="absolute inset-0 w-full h-full object-fill pointer-events-none z-0"
      />
      <div class="relative z-10 p-7 lg:p-10">
        <h3 class="font-bold text-2xl mb-3 font-sans leading-tight lg:text-3xl">
          Lo que te llega cada lunes
        </h3>
        <p class="text-sm font-display leading-relaxed mb-2 text-white/90 lg:text-base">
          Una historia, una herramienta y una idea para empezar la semana sin sentirte tan perdida.
        </p>
        <p class="text-sm font-display mb-6 text-white/90 lg:text-base">
          Con tu <span class="font-bold underline">descuento</span> por una mama, para mamas.
        </p>
        <input
          type="email"
          placeholder="Tu correo electrónico"
          class="w-full px-4 py-3 rounded-lg text-gray-800 text-sm font-display mb-3 focus:outline-none bg-white"
        />
        <button class="w-full bg-[#FAED37] text-black font-bold py-3 rounded-lg font-sans tracking-widest text-sm hover:bg-yellow-300 transition-colors">
          Quiero recibirlo
        </button>
      </div>
    </div>
  </div>

  <!-- Footer principal -->
  <div class="bg-[#3D1A6E] text-white py-10 px-5 lg:px-16 lg:py-14">

    <!-- Desktop: 4 columnas | Móvil: bloque -->
    <div class="lg:grid lg:grid-cols-4 lg:gap-12 lg:items-start">

      <!-- Columna 1: Logo + contacto -->
      <div class="mb-8 lg:mb-0">
        <img src="/logo_emprendedoras_en_panales.svg" alt="Emprendedoras en Pañales" class="h-20 w-auto mb-4 invert brightness-0 saturate-0 lg:h-24" />
        <div class="space-y-2">
          <div class="flex items-center gap-2 text-sm font-display text-white/80">
            <span>📱</span>
            <span>0823 23283 2322</span>
          </div>
          <div class="flex items-center gap-2 text-sm font-display text-white/80">
            <span>✉️</span>
            <span>emprendedorasenpa@gmail.com</span>
          </div>
        </div>
      </div>

      <!-- Columna 2: Navegación -->
      <div class="mb-8 lg:mb-0">
        <h4 class="font-bold text-sm mb-4 font-sans lg:text-base">Navegation</h4>
        <ul class="space-y-2 text-sm font-display text-white/70 lg:text-base">
          <li><a href="#" class="hover:text-white transition-colors">Home</a></li>
          <li><a href="#" class="hover:text-white transition-colors">Patrocinadores</a></li>
          <li><a href="#" class="hover:text-white transition-colors">Cuéntanos tu historia</a></li>
          <li><a href="#" class="hover:text-white transition-colors">Blog</a></li>
        </ul>
      </div>

      <!-- Columna 3: Legal -->
      <div class="mb-8 lg:mb-0">
        <h4 class="font-bold text-sm mb-4 font-sans lg:text-base">Legal</h4>
        <ul class="space-y-2 text-sm font-display text-white/70 lg:text-base">
          <li><a href="#" class="hover:text-white transition-colors">Privacidad</a></li>
          <li><a href="#" class="hover:text-white transition-colors">Términos</a></li>
        </ul>
      </div>

      <!-- Columna 4: Nuestra visión + redes -->
      <div class="mb-8 lg:mb-0">
        <h4 class="font-bold text-sm mb-4 font-sans lg:text-base">Nuestra visión</h4>
        <blockquote class="text-sm font-display italic mb-6 text-white/80 leading-relaxed">
          "Porque emprender con un bebé en brazos no es un obstáculo, es tu superpoder"
        </blockquote>
        <div class="flex gap-3">
          <a href="#" aria-label="Instagram" class="w-9 h-9 bg-white/10 rounded-full flex items-center justify-center hover:bg-white/20 transition-colors">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
