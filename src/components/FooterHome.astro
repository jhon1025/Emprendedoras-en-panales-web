---
const marcas = [
  { src: '/pocion.png', alt: 'Poción' },
  { src: '/uconex.png', alt: 'Uconex' },
  { src: '/natmat.png', alt: 'Natmat' },
  { src: '/everydaylove.png', alt: 'Everyday Love' },
  { src: '/huellapura.png', alt: 'Huella Pura' },
  { src: '/hlala!beautybar.png', alt: 'Hlala Beauty Bar' },
  { src: '/diana.png', alt: 'Diana' },
  { src: '/cadu.png', alt: 'Cadu' },
  { src: '/casaraiz.png', alt: 'Casa Raiz' },
];
---
<footer>

  <!-- Logos de marcas -->
  <div class="bg-white pt-16 pb-8 px-5 lg:pt-20 lg:pb-12 lg:px-32">
    <!-- Móvil: grid 3 columnas | Desktop: grid 2 filas centrado -->
    <div class="grid grid-cols-3 gap-6 items-center justify-items-center lg:hidden">
      {marcas.map((m) => (
        <img src={m.src} alt={m.alt} class="h-10 w-auto object-contain" />
      ))}
    </div>
    <div class="hidden lg:grid lg:grid-cols-5 lg:gap-x-16 lg:gap-y-8 lg:items-center lg:justify-items-center">
      {marcas.map((m) => (
        <img src={m.src} alt={m.alt} class="h-10 w-auto object-contain" />
      ))}
    </div>
  </div>

  <!-- Newsletter blob -->
  <div class="bg-white px-5 pt-2 pb-10 lg:pb-20 lg:px-16">
    <div class="relative text-white text-center lg:max-w-lg lg:mx-auto">
      <img
        src="/nuberosada.png"
        alt=""
        aria-hidden="true"
        class="absolute inset-0 w-full h-full object-fill pointer-events-none z-0"
      />
      <div class="relative z-10 p-7 lg:p-10">
        <h3 class="font-bold text-2xl mb-3 font-sans leading-tight lg:text-3xl">
          Lo que te llega cada lunes
        </h3>
        <p class="text-sm font-display leading-relaxed mb-2 text-white/90 lg:text-base">
          Una historia, una herramienta y una idea para empezar la semana sin sentirte tan perdida.
        </p>
        <p class="text-sm font-display mb-6 text-white/90 lg:text-base">
          Con tu <span class="font-bold underline">descuento</span> por una mama, para mamas.
        </p>
        <input
          type="email"
          placeholder="Tu correo electrónico"
          class="w-full px-4 py-3 rounded-lg text-gray-800 text-sm font-display mb-3 focus:outline-none bg-white"
        />
        <button class="w-full bg-[#FAED37] text-black font-bold py-3 rounded-lg font-sans tracking-widest text-sm hover:bg-yellow-300 transition-colors">
          Quiero recibirlo
        </button>
      </div>
    </div>
  </div>

</footer>
