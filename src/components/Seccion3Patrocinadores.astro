---
---

<section class="relative bg-[#E75F24] pt-10 pb-0 px-8 lg:px-16">

  <!-- Título "Nuestro alcance en redes" — derecha con línea -->
  <div class="flex items-center justify-end mb-8 lg:mb-10 gap-0">
    <div class="flex-1 h-[2px] bg-white opacity-60"></div>
    <div class="bg-white rounded-full px-6 py-2 shrink-0 ml-0">
      <p class="font-display text-[#E75F24] font-bold text-[18px] lg:text-[28px] whitespace-nowrap">Nuestro alcance en redes</p>
    </div>
  </div>

  <!-- Contenedor principal: barras + micrófono -->
  <div class="relative flex items-center gap-6 pb-12 lg:pb-20">

    <!-- Barras de redes sociales -->
    <div class="flex-1 flex flex-col gap-5">

      <!-- Facebook -->
      <div class="flex items-center gap-4">
        <div class="flex items-center gap-2 w-[130px] lg:w-[160px] shrink-0">
          <img src="/icon_facebook.png" alt="Facebook" class="w-8 h-8 lg:w-10 lg:h-10 rounded-full" />
          <span class="font-sans text-white text-[14px] lg:text-[18px] font-medium">Facebook</span>
        </div>
        <div class="flex-1 relative h-[22px] lg:h-[26px] rounded-full bg-[#F09070] overflow-hidden">
          <div class="absolute left-0 top-0 h-full bg-[#A8D840] rounded-full" style="width: 100%;"></div>
        </div>
        <span class="font-display text-white font-bold text-[22px] lg:text-[30px] w-[50px] lg:w-[60px] text-right shrink-0">34k</span>
      </div>

      <!-- TikTok -->
      <div class="flex items-center gap-4">
        <div class="flex items-center gap-2 w-[130px] lg:w-[160px] shrink-0">
          <img src="/icon_tiktok.png" alt="TikTok" class="w-8 h-8 lg:w-10 lg:h-10 rounded-full" />
          <span class="font-sans text-white text-[14px] lg:text-[18px] font-medium">Tiktok</span>
        </div>
        <div class="flex-1 relative h-[22px] lg:h-[26px] rounded-full bg-[#F09070] overflow-hidden">
          <div class="absolute left-0 top-0 h-full bg-[#A8D840] rounded-full" style="width: 65%;"></div>
        </div>
        <span class="font-display text-white font-bold text-[22px] lg:text-[30px] w-[50px] lg:w-[60px] text-right shrink-0">22k</span>
      </div>

      <!-- YouTube -->
      <div class="flex items-center gap-4">
        <div class="flex items-center gap-2 w-[130px] lg:w-[160px] shrink-0">
          <img src="/icon_youtube.png" alt="Youtube" class="w-8 h-8 lg:w-10 lg:h-10 rounded-full" />
          <span class="font-sans text-white text-[14px] lg:text-[18px] font-medium">Youtube</span>
        </div>
        <div class="flex-1 relative h-[22px] lg:h-[26px] rounded-full bg-[#F09070] overflow-hidden">
          <div class="absolute left-0 top-0 h-full bg-[#A8D840] rounded-full" style="width: 32%;"></div>
        </div>
        <span class="font-display text-white font-bold text-[22px] lg:text-[30px] w-[50px] lg:w-[60px] text-right shrink-0">11k</span>
      </div>

      <!-- Instagram -->
      <div class="flex items-center gap-4">
        <div class="flex items-center gap-2 w-[130px] lg:w-[160px] shrink-0">
          <img src="/icon_instagram.png" alt="Instagram" class="w-8 h-8 lg:w-10 lg:h-10 rounded-full" />
          <span class="font-sans text-white text-[14px] lg:text-[18px] font-medium">Instagram</span>
        </div>
        <div class="flex-1 relative h-[22px] lg:h-[26px] rounded-full bg-[#F09070] overflow-hidden">
          <div class="absolute left-0 top-0 h-full bg-[#A8D840] rounded-full" style="width: 44%;"></div>
        </div>
        <span class="font-display text-white font-bold text-[22px] lg:text-[30px] w-[50px] lg:w-[60px] text-right shrink-0">15k</span>
      </div>

    </div>

    <!-- Micrófono decorativo derecha -->
    <img
      src="/microfono_blanco.png"
      alt=""
      aria-hidden="true"
      class="hidden lg:block w-[140px] shrink-0 opacity-90"
    />

  </div>

  <!-- Transición scallops: blanco sube al naranja -->
  <div class="-mx-8 lg:-mx-16 w-auto" style="line-height: 0; margin-bottom: -1px;">
    <!-- Móvil: 6 scallops -->
    <svg viewBox="0 0 720 80" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none"
         class="w-full block lg:hidden" style="height: 60px;">
      <path d="M0,80 L720,80 L720,60 A60,60 0 0,0 600,60 A60,60 0 0,0 480,60 A60,60 0 0,0 360,60 A60,60 0 0,0 240,60 A60,60 0 0,0 120,60 A60,60 0 0,0 0,60 Z" fill="white"/>
    </svg>
    <!-- Desktop: 12 scallops (120px c/u, r=60) -->
    <svg viewBox="0 0 1440 80" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none"
         class="w-full hidden lg:block" style="height: 80px;">
      <path d="M0,80 L1440,80 L1440,60 A60,60 0 0,0 1320,60 A60,60 0 0,0 1200,60 A60,60 0 0,0 1080,60 A60,60 0 0,0 960,60 A60,60 0 0,0 840,60 A60,60 0 0,0 720,60 A60,60 0 0,0 600,60 A60,60 0 0,0 480,60 A60,60 0 0,0 360,60 A60,60 0 0,0 240,60 A60,60 0 0,0 120,60 A60,60 0 0,0 0,60 Z" fill="white"/>
    </svg>
  </div>

</section>
