---
---

<section class="bg-white pt-8 lg:pt-10 pb-16 lg:pb-24 px-6 lg:px-20 overflow-x-hidden">

  <div class="relative max-w-2xl lg:max-w-3xl mx-auto lg:mx-auto">

    <img src="/gimmick_naranja_s6.png" alt="" aria-hidden="true"
         class="hidden lg:block absolute top-1/2 -translate-y-1/2 -right-[220px] w-[520px] h-auto z-0" />

    <div class="relative z-10 bg-[#EC4699] rounded-[24px] lg:rounded-[32px] p-6 py-8 lg:p-12">

    <h2 class="font-display font-light text-white text-[26px] lg:text-[36px] text-center leading-tight lg:leading-tight">¿Hablamos de tu marca?</h2>

    <p class="mt-3 lg:mt-4 font-sans text-white text-[13px] lg:text-[15px] text-center leading-relaxed max-w-md lg:max-w-xl mx-auto lg:mx-auto">
      Completa el formulario y nuestro equipo <span class="font-bold">te contactará en menos de 48 horas</span> con una propuesta a la medida de tus objetivos.
    </p>

    <form data-netlify="true" name="propuesta-patrocinio" method="POST" class="mt-6 lg:mt-9 space-y-4 lg:space-y-5">
      <input type="hidden" name="form-name" value="propuesta-patrocinio" />

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 lg:gap-5">
        <div>
          <label class="block font-sans font-semibold text-white text-[13px] lg:text-[14px] mb-2 lg:mb-2">Nombre completo</label>
          <input type="text" name="nombre" placeholder="Ej: Ana García"
                 class="w-full bg-white rounded-full px-5 py-3 lg:px-5 lg:py-3.5 font-sans text-[13px] lg:text-[14px] text-gray-700 placeholder-gray-400 outline-none" />
        </div>
        <div>
          <label class="block font-sans font-semibold text-white text-[13px] lg:text-[14px] mb-2 lg:mb-2">Email corporativo</label>
          <input type="email" name="email" placeholder="Ana@marca.com"
                 class="w-full bg-white rounded-full px-5 py-3 lg:px-5 lg:py-3.5 font-sans text-[13px] lg:text-[14px] text-gray-700 placeholder-gray-400 outline-none" />
        </div>
      </div>

      <div>
        <label class="block font-sans font-semibold text-white text-[13px] lg:text-[14px] mb-2 lg:mb-2">¿En qué paquete estás interesado?</label>
        <input type="text" name="paquete" placeholder="Pack temporada completa"
               class="w-full bg-white rounded-full px-5 py-3 lg:px-5 lg:py-3.5 font-sans text-[13px] lg:text-[14px] text-gray-700 placeholder-gray-400 outline-none" />
      </div>

      <div>
        <label class="block font-sans font-semibold text-white text-[13px] lg:text-[14px] mb-2 lg:mb-2">Cuéntanos sobre tu marca</label>
        <textarea name="mensaje" rows="4" placeholder="¿Qué objetivos buscas alcanzar?"
                  class="w-full bg-white rounded-[20px] lg:rounded-[20px] px-5 py-4 lg:px-5 lg:py-4 font-sans text-[13px] lg:text-[14px] text-gray-700 placeholder-gray-400 outline-none resize-none"></textarea>
      </div>

      <div class="text-center pt-2 lg:pt-3">
        <button type="submit"
                class="bg-white text-[#EC4699] font-sans font-bold text-[14px] lg:text-[15px] rounded-full px-8 py-3 lg:px-10 lg:py-3.5">
          Enviar propuesta
        </button>
      </div>
    </form>

    </div>

  </div>

</section>
