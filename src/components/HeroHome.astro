---
---
<section class="bg-white relative overflow-hidden">

  <!-- Texto superior -->
  <div class="px-5 lg:px-5 pt-8 pb-6 text-center lg:pt-16 lg:pb-8 lg:max-w-5xl lg:mx-auto">

    <div class="lg:text-left">
      <span class="inline-block bg-[#6A3A9F] text-white text-xs font-bold px-3 py-1 rounded mb-5 lg:mb-5 font-sans tracking-wide lg:tracking-wide lg:text-xl lg:px-10 lg:py-4 lg:-rotate-12">
        Podcast + Comunidad
      </span>
    </div>

    <h1 class="font-bold text-[2.6rem] leading-[1.1] mb-5 lg:mb-5 text-black font-sans lg:text-[4rem]">
      Eres <em class="text-[#E75F24] not-italic">mamá.</em> Eres <span class="text-[#6A3A9F]">emprendedora.</span><br />Aquí no tienes que elegir.
    </h1>

    <p class="text-gray-600 text-sm leading-relaxed mb-4 lg:mb-4 font-display lg:text-base lg:max-w-2xl lg:mx-auto">
      Únete a la comunidad de <span class="text-[#E75F24] font-semibold">mujeres</span> que están
      <span class="text-[#E75F24] font-semibold">construyendo negocios reales</span> con un hijo en
      la cadera, una junta en el celular y
      <span class="text-[#E75F24] font-semibold">cero culpa por intentarlo todo a la vez.</span>
    </p>

    <p class="text-black text-sm font-bold leading-relaxed mb-6 lg:mb-6 font-sans lg:text-base">
      Cada semana recibes una historia real. una herramienta práctica y un recordatorio de que no estás sola.
    </p>

    <div class="lg:flex lg:flex-col lg:items-center lg:mx-auto">
      <input
        type="email"
        placeholder="Tu correo electrónico"
        class="w-full px-4 lg:px-4 py-3 lg:py-3 rounded-lg border border-gray-300 bg-white text-sm lg:text-sm font-display placeholder-gray-400 mb-3 focus:outline-none focus:ring-2 focus:ring-[#6A3A9F] text-center lg:mb-4 lg:w-80"
      />
      <button class="w-full bg-gradient-to-r from-[#E75F24] to-[#6A3A9F] text-white font-bold py-3 lg:py-3 rounded-lg text-sm lg:text-sm tracking-widest lg:tracking-widest font-sans lg:w-auto lg:px-10">
        Quiero suscribirme
      </button>
    </div>
  </div>

  <!-- Foto de Lizseth con flores decorativas -->
  <div class="relative flex justify-center items-end h-80 overflow-hidden lg:h-[55vh]">

    <img src="/nubeverde.png" alt="" aria-hidden="true"
      class="absolute bottom-0 left-1/2 lg:left-1/2 -translate-x-1/2 lg:-translate-x-1/2 w-72 h-72 object-contain z-0 lg:w-[36rem] lg:h-[36rem] lg:-bottom-36" />

    <!-- IZQUIERDA: nubenaranja, flor_pink, estrella_amarilla, estrellamorada -->
    <img src="/nubenaranja.png" alt="" aria-hidden="true"
      class="absolute top-[20px] left-[10px] w-[104px] lg:w-[104px] h-[104px] lg:h-[104px] object-contain z-10 lg:top-[40px] lg:left-[200px]" />

    <img src="/flor_pink.png" alt="" aria-hidden="true"
      class="absolute bottom-[30px] left-[30px] w-[104px] lg:w-[104px] h-[104px] lg:h-[104px] object-contain z-20 lg:bottom-[60px] lg:left-[280px]" />

    <img src="/estrella_amarilla_blogind.png" alt="" aria-hidden="true"
      class="absolute bottom-[105px] left-[40px] w-[104px] lg:w-[104px] h-[104px] lg:h-[104px] object-contain z-20 lg:bottom-[160px] lg:left-[340px]" />

    <img src="/estrellamorada.png" alt="" aria-hidden="true"
      class="absolute top-[10px] left-[90px] w-[104px] lg:w-[104px] h-[104px] lg:h-[104px] object-contain z-20 lg:top-[20px] lg:left-[390px]" />

    <!-- DERECHA: estrellanaranja, nubeamarilla, flor_verde -->
    <img src="/estrellanaranja.png" alt="" aria-hidden="true"
      class="absolute bottom-[30px] right-[30px] w-[104px] lg:w-[104px] h-[104px] lg:h-[104px] object-contain z-20 lg:bottom-[60px] lg:right-[280px]" />

    <img src="/nubeamarilla.png" alt="" aria-hidden="true"
      class="absolute top-[80px] right-[40px] w-[104px] lg:w-[104px] h-[104px] lg:h-[104px] object-contain z-10 lg:top-[20px] lg:right-[330px]" />

    <img src="/flor_verde.png" alt="" aria-hidden="true"
      class="absolute top-[20px] right-[10px] w-[104px] lg:w-[104px] h-[104px] lg:h-[104px] object-contain z-20 lg:top-[50px] lg:right-[200px]" />

    <img
      src="/Lizseth_Henao%20.png"
      alt="Lizseth Henao, Host"
      class="relative z-10 h-80 w-auto lg:w-auto object-contain object-bottom translate-y-[5px] lg:translate-y-[5px] lg:h-full"
    />

    <div class="absolute bottom-5 right-5 z-20 w-fit lg:w-fit lg:bottom-[calc(45%+30px)] lg:right-[24%]">
      <div class="relative bg-[#D4187D] text-white text-[10px] font-bold px-3 py-2 rounded-2xl font-sans whitespace-nowrap lg:text-sm lg:px-5 lg:py-3">
        Con tu Host Lizseth Henao
        <!-- cola apuntando a la izquierda hacia Lizseth -->
        <div class="absolute left-0 lg:left-0 -bottom-1 lg:-bottom-1 -translate-x-full lg:-translate-x-full rotate-[-30deg] lg:rotate-[-30deg] border-t-[7px] border-t-transparent border-r-[10px] border-r-[#D4187D] border-b-[7px] border-b-transparent"></div>
      </div>
    </div>
  </div>

</section>
