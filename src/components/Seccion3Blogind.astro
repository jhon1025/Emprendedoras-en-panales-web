---
<section class="bg-white py-10 px-6 lg:py-14 lg:pl-24 lg:pr-0">
  <div class="lg:grid lg:grid-cols-[1fr_340px] lg:gap-16">

    <!-- Columna izquierda -->
    <div class="lg:pr-10 lg:border-r lg:border-gray-200">

      <h2 class="font-sans font-bold uppercase text-[#945DA7] text-[15px] lg:text-[16px] tracking-wide mb-3">
        Lorem Ipsumeee
      </h2>
      <p class="font-sans text-gray-700 text-[14px] lg:text-[15px] leading-relaxed mb-8">
        Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium, totam rem aperiam, eaque ipsa quae ab illo inventore veritatis et quasi architecto beatae vitae dicta sunt explicabo. Nemo enim ipsam voluptatem quia voluptas sit aspernatur aut odit aut fugit, sed quia consequuntur magni dolores eos qui ratione voluptatem sequi nesciunt.
      </p>

      <h2 class="font-sans font-bold uppercase text-[#945DA7] text-[15px] lg:text-[16px] tracking-wide mb-3">
        Lorem Ipsumeee
      </h2>

      <img
        src="/tablero_notas_blogind_s3.png"
        alt="Tablero de notas adhesivas con palabras clave de planeación"
        class="w-full rounded-2xl mb-8"
      />

      <p class="font-sans text-gray-700 text-[14px] lg:text-[15px] leading-relaxed">
        <strong class="text-black">Sed</strong> ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium, totam rem aperiam, eaque ipsa quae ab illo inventore veritatis et quasi architecto beatae vitae dicta sunt explicabo. Nemo enim ipsam <strong class="text-black">voluptatem</strong> quia voluptas sit aspernatur aut odit aut fugit, sed quia consequuntur magni dolores eos qui ratione voluptatem sequi nesciunt, neque porro quisquam est qui dolorem ipsum quia dolor sit amet consectetur adipisci velit.
      </p>

    </div>

    <!-- Columna derecha -->
    <div class="mt-10 lg:mt-0 lg:pl-2">

      <!-- Tarjeta podcast -->
      <a href="#" class="flex items-center gap-4 rounded-[28px] lg:rounded-r-none bg-[#EC4699] p-3 mb-8 hover:opacity-90 transition-opacity">
        <img
          src="/podcast_insignificante_blogind_s3.png"
          alt="Podcast: Me sentía insignificante"
          class="w-[110px] h-[110px] rounded-2xl object-cover shrink-0"
        />
        <div class="pr-4">
          <span class="font-sans font-semibold text-white text-[13px] pb-1.5 border-b border-white/60 inline-block">Podcast</span>
          <h3 class="font-display font-bold text-white text-[17px] leading-[1.2] mt-2">
            Me sentía insignificante
          </h3>
          <p class="font-sans text-white text-[11px] mt-1 opacity-90">Emprendedoras en pañales</p>
        </div>
      </a>

      <!-- Artículos relacionados -->
      <h3 class="font-sans font-bold text-black text-[16px] mb-2">Artículos relacionados</h3>
      <div class="h-[2px] bg-[#E75F24] w-full mb-5"></div>

      <div class="flex flex-col gap-5 mb-10">

        <a href="#" class="flex items-center gap-4 hover:opacity-80 transition-opacity">
          <img src="/articulo_mitos_blogind_s3.png" alt="" class="w-[80px] h-[80px] rounded-xl object-cover shrink-0" />
          <div>
            <span class="inline-block bg-[#A9CF38] text-white font-sans text-[10px] font-semibold px-3 py-1 rounded-full mb-1.5">Negocios</span>
            <h4 class="font-sans font-bold text-black text-[14px] leading-[1.25]">Desmintiendo mitos sobre emprender</h4>
          </div>
        </a>

        <a href="#" class="flex items-center gap-4 hover:opacity-80 transition-opacity">
          <img src="/articulo_maternidad_blogind_s3.png" alt="" class="w-[80px] h-[80px] rounded-xl object-cover shrink-0" />
          <div>
            <span class="inline-block bg-[#945DA7] text-white font-sans text-[10px] font-semibold px-3 py-1 rounded-full mb-1.5">Maternidad</span>
            <h4 class="font-sans font-bold text-black text-[14px] leading-[1.25]">Tips para tener tu maternidad controlada</h4>
          </div>
        </a>

        <a href="#" class="flex items-center gap-4 hover:opacity-80 transition-opacity">
          <img src="/articulo_agenda_blogind_s3.png" alt="" class="w-[80px] h-[80px] rounded-xl object-cover shrink-0" />
          <div>
            <span class="inline-block bg-[#E75F24] text-white font-sans text-[10px] font-semibold px-3 py-1 rounded-full mb-1.5">Productividad</span>
            <h4 class="font-sans font-bold text-black text-[14px] leading-[1.25]">5 Hacks para organizar tu agenda entre tomas</h4>
          </div>
        </a>

      </div>

      <!-- Newsletter -->
      <div class="relative overflow-hidden rounded-2xl lg:rounded-r-none bg-[#EC4699] px-6 py-7">
        <img
          src="/personaje_newsletter_blogind_s3.png"
          alt=""
          aria-hidden="true"
          class="absolute top-0 right-0 w-[140px] pointer-events-none"
        />
        <h3 class="relative font-display font-bold text-white text-[18px] leading-[1.2] mb-2 max-w-[200px]">
          ¿Quieres recibir más consejos relacionados?
        </h3>
        <p class="relative font-sans text-white text-[12px] leading-relaxed opacity-90 mb-5 max-w-[220px]">
          Dolorem que laudantium, totam rem aperiam, eaque ipsa quae ab illo inventore veritatis et quasi.
        </p>
        <form data-netlify="true" name="newsletter-blogind" method="POST" class="relative flex flex-col gap-3">
          <input
            type="email"
            name="email"
            placeholder="Tu correo electrónico"
            required
            class="w-full bg-white rounded-full px-5 py-2.5 text-sm font-sans text-gray-700 outline-none placeholder-gray-400"
          />
          <button
            type="submit"
            class="bg-white text-[#EC4699] font-sans font-bold text-sm px-6 py-2.5 rounded-full hover:opacity-90 transition-opacity"
          >
            Quiero suscribirme
          </button>
        </form>
      </div>

    </div>

  </div>
</section>
