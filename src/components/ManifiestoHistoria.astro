---
---
<section class="bg-white pt-16 pb-0 px-5 relative lg:pt-20 lg:px-16">

  <!-- Título -->
  <div class="text-center mb-5 lg:mb-6">
    <h2 class="font-bold text-4xl font-sans leading-tight lg:text-5xl">
      Comienza tu{' '}
      <span class="bg-[#E75F24] text-white px-5 py-2 rounded-xl inline-block">manifiesto</span>
    </h2>
  </div>

  <!-- Subtítulo -->
  <p class="text-center text-sm font-display text-gray-700 max-w-lg mx-auto mb-10 leading-relaxed lg:text-base lg:max-w-2xl">
    Completa el formulario y nuestro equipo revisará tu historia.{' '}
    <span class="text-[#E75F24]">Si hay match, te contactamos para agendar la grabación.</span>{' '}
    Sin compromiso, sin guiones. Solo tú y el micrófono.
  </p>

  <!-- Decorativo verde izquierda (desktop) -->
  <img src="/nubeverde.png" alt="" aria-hidden="true"
    class="hidden lg:block absolute bottom-[8%] left-[1%] w-[14%] z-10" />

  <!-- Decorativo amarillo derecha (desktop) -->
  <img src="/nubeamarilla.png" alt="" aria-hidden="true"
    class="hidden lg:block absolute bottom-[12%] right-[1%] w-[10%] z-10" />

  <!-- Tarjeta del formulario -->
  <div class="bg-[#E75F24] rounded-3xl px-6 py-10 max-w-2xl mx-auto relative z-20 lg:px-12 lg:py-14">
    <form data-netlify="true" name="historia" method="POST">

      <!-- Fila 1: Nombre + Email -->
      <div class="space-y-5 mb-5 lg:space-y-0 lg:grid lg:grid-cols-2 lg:gap-6 lg:mb-6">
        <div>
          <label class="block text-white text-sm font-display mb-2">Nombre completo</label>
          <input
            type="text"
            name="nombre"
            placeholder="Ej: Sofia Ruiz"
            class="w-full bg-white rounded-full px-5 py-3 text-sm font-display text-gray-700 outline-none placeholder-gray-400"
          />
        </div>
        <div>
          <label class="block text-white text-sm font-display mb-2">Email</label>
          <input
            type="email"
            name="email"
            placeholder="Sofia@gmail.com"
            class="w-full bg-white rounded-full px-5 py-3 text-sm font-display text-gray-700 outline-none placeholder-gray-400"
          />
        </div>
      </div>

      <!-- Fila 2: Desafío -->
      <div class="mb-5 lg:mb-6">
        <label class="block text-white text-sm font-display mb-2">¿Cuál es tu mayor desafío actual?</label>
        <input
          type="text"
          name="desafio"
          placeholder="Esa montaña que estas escalando"
          class="w-full bg-white rounded-full px-5 py-3 text-sm font-display text-gray-700 outline-none placeholder-gray-400"
        />
      </div>

      <!-- Fila 3: Marca -->
      <div class="mb-6 lg:mb-8">
        <label class="block text-white text-sm font-display mb-2">Cuéntanos sobre tu marca</label>
        <textarea
          name="marca"
          placeholder="¿Qué estas construyendo?"
          rows="5"
          class="w-full bg-white rounded-2xl px-5 py-3 text-sm font-display text-gray-700 outline-none placeholder-gray-400 resize-none"
        ></textarea>
      </div>

      <!-- Checkbox -->
      <div class="flex items-start gap-3 mb-8">
        <input type="checkbox" name="terminos" id="terminos" class="mt-1 w-4 h-4 flex-shrink-0 cursor-pointer" />
        <label for="terminos" class="text-white text-sm font-display cursor-pointer">
          Estoy de acuerdo con los términos y condiciones establecidos.
        </label>
      </div>

      <!-- Botón -->
      <div class="text-center">
        <button
          type="submit"
          class="bg-white text-[#E75F24] font-bold font-sans py-3 px-12 rounded-full text-base hover:bg-orange-50 transition-colors"
        >
          <span class="lg:hidden">Enviar propuesta</span>
          <span class="hidden lg:inline">Enviar mi historia</span>
        </button>
      </div>

    </form>
  </div>

  <!-- Espaciado inferior -->
  <div class="h-16 lg:h-20"></div>

</section>
