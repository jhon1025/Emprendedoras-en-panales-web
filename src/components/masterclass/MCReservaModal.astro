---
// Componente: MCReservaModal.astro
// Modal de reserva (nombre, correo, teléfono). Al enviar abre WhatsApp con un
// mensaje prellenado hacia el número del negocio.
// Se abre desde cualquier CTA con el atributo [data-open-reserva].
// Usa <dialog> nativo → foco atrapado, ESC para cerrar y backdrop accesibles.
const WHATSAPP = '573217632663';
---

<dialog
  id="reserva-modal"
  class="w-[92%] max-w-md rounded-3xl border-0 bg-white p-0 text-left shadow-2xl backdrop:bg-black/50 backdrop:backdrop-blur-sm"
>
  <div class="relative p-6 sm:p-8">
    <!-- Cerrar -->
    <button
      type="button"
      data-close-reserva
      aria-label="Cerrar"
      class="absolute right-4 top-4 flex h-9 w-9 items-center justify-center rounded-full bg-gray-100 text-gray-500 transition hover:bg-gray-200"
    >
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
      </svg>
    </button>

    <h2 class="font-sans text-2xl font-bold text-[#6A3A9F]">Reserva tu cupo</h2>
    <p class="mt-1 font-display text-sm text-gray-500">
      Déjanos tus datos y seguimos por WhatsApp para coordinar tu pago.
    </p>

    <form id="reserva-form" class="mt-5 space-y-4" novalidate>
      <div>
        <label for="rv-nombre" class="block font-display text-sm font-medium text-gray-700">Nombre</label>
        <input
          id="rv-nombre" name="nombre" type="text" required autocomplete="name" placeholder="Tu nombre"
          class="mt-1 w-full rounded-xl border border-gray-300 px-4 py-3 font-display text-gray-900 outline-none transition focus:border-[#945DA7] focus:ring-2 focus:ring-[#945DA7]/30"
        />
      </div>
      <div>
        <label for="rv-correo" class="block font-display text-sm font-medium text-gray-700">Correo</label>
        <input
          id="rv-correo" name="correo" type="email" required autocomplete="email" placeholder="tucorreo@ejemplo.com"
          class="mt-1 w-full rounded-xl border border-gray-300 px-4 py-3 font-display text-gray-900 outline-none transition focus:border-[#945DA7] focus:ring-2 focus:ring-[#945DA7]/30"
        />
      </div>
      <div>
        <label for="rv-telefono" class="block font-display text-sm font-medium text-gray-700">Teléfono</label>
        <input
          id="rv-telefono" name="telefono" type="tel" required autocomplete="tel" placeholder="+57 300 000 0000"
          class="mt-1 w-full rounded-xl border border-gray-300 px-4 py-3 font-display text-gray-900 outline-none transition focus:border-[#945DA7] focus:ring-2 focus:ring-[#945DA7]/30"
        />
      </div>

      <button
        type="submit"
        class="mt-2 flex w-full items-center justify-center gap-2 rounded-full bg-[#25D366] px-6 py-3.5 font-sans text-lg font-bold text-white shadow-lg transition hover:brightness-105 active:scale-[.98] focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#25D366]/40"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
          <path d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 0 1 8.413 3.488 11.824 11.824 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 0 0 1.51 5.26l-.999 3.648 3.738-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.71.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
        </svg>
        Continuar por WhatsApp
      </button>
      <p class="text-center font-display text-xs text-gray-400">
        Pago por Nequi, Bancolombia o transferencia.
      </p>
    </form>
  </div>
</dialog>

<script define:vars={{ WHATSAPP }}>
  function initReservaModal() {
    const modal = document.getElementById('reserva-modal');
    if (!modal) return;
    const form = document.getElementById('reserva-form');

    // Abrir desde cualquier CTA [data-open-reserva]
    document.querySelectorAll('[data-open-reserva]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        modal.showModal();
        document.getElementById('rv-nombre')?.focus();
      });
    });

    // Cerrar con el botón ✕
    modal.querySelectorAll('[data-close-reserva]').forEach((btn) => {
      btn.addEventListener('click', () => modal.close());
    });

    // Cerrar al hacer click en el backdrop (fuera del contenido)
    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });

    // Enviar → abrir WhatsApp con los datos prellenados
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      const nombre = (data.get('nombre') || '').toString().trim();
      const correo = (data.get('correo') || '').toString().trim();
      const telefono = (data.get('telefono') || '').toString().trim();

      const mensaje =
        `¡Hola! Quiero reservar mi cupo para la masterclass.\n\n` +
        `Nombre: ${nombre}\n` +
        `Correo: ${correo}\n` +
        `Teléfono: ${telefono}`;

      const url = `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(mensaje)}`;
      window.open(url, '_blank', 'noopener');
      modal.close();
      form.reset();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initReservaModal);
  } else {
    initReservaModal();
  }
</script>
