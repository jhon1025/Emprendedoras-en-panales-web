---
// Componente: MCHero.astro — Hero de la masterclass (mobile first, responsive)
// La foto de Lizeth viene ya compuesta (blob verde + estrellas + globo rosa)
// en lizeth_header.webp, así que el hero = texto + imagen + tarjeta de cupos.
const marqueeItems = ['Masterclass', 'Solo 20 cupos', 'Empieza ya'];
---

<section class="relative overflow-hidden bg-[#945DA7] font-sans text-white">

  <!-- Bloque de texto -->
  <div class="mx-auto max-w-md px-5 pt-8 text-center sm:pt-10">

    <!-- Logo de marca (dentro del hero, centrado) -->
    <img
      src="/masterclass/logo_positivo_crop.svg"
      alt="Emprendedoras en Pañales"
      width="160"
      height="117"
      class="mx-auto w-36 drop-shadow-[0_8px_12px_rgba(0,0,0,0.18)] sm:w-40 md:w-44"
    />

    <!-- Badge -->
    <p class="mt-6 inline-block rounded-full bg-white px-5 py-2 text-xs font-black uppercase tracking-[0.15em] text-[#EB6024] sm:text-sm">
      Masterclass para emprendedoras
    </p>

    <!-- Titular -->
    <h1 class="mt-6 text-[2rem] font-bold leading-[1.08] sm:text-[2.75rem]">
      Llevas <span class="inline-block rounded-lg bg-[#FAED37] px-2 leading-tight text-[#6A3A9F]">meses</span> grabando.<br />
      Es hora de que tu canal trabaje para tu negocio
    </h1>

    <!-- Subtítulo -->
    <p class="mx-auto mt-5 max-w-sm font-display text-sm leading-relaxed text-white/90 sm:text-base">
      Un masterclass de 3 horas para configurar, diseñar y monetizar tu canal de
      Youtube y Podcast desde el primer episodio. Con sistema, no con suerte.
    </p>

    <!-- CTA → abre el modal de reserva -->
    <button
      type="button"
      data-open-reserva
      class="mt-7 inline-block w-full max-w-xs rounded-full bg-[#FAED37] px-6 py-4 text-center text-lg font-bold text-black shadow-lg transition hover:brightness-105 active:scale-[.98] focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-white/60 sm:text-xl"
    >
      Quiero mi cupo 20 USD
    </button>

    <!-- Info de pago -->
    <p class="mt-3 font-display text-xs text-white/70 sm:text-sm">
      $20 USD · Pago por Nequi, Bancolombia o transferencia
    </p>
  </div>

  <!-- Composición de Lizeth (foto + blob + estrellas + globo, todo en la imagen) -->
  <div class="relative z-0 mx-auto -mt-2 max-w-md px-4">
    <img
      src="/masterclass/lizeth_header.webp"
      alt="Lizeth Henao, tu host de la masterclass"
      width="1888"
      height="1888"
      class="mx-auto w-full"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <!-- Tarjeta de cupos: PEGADA a la foto. Solapa unos px (estrategia barriguita)
       para que el borde recto del card tape el borde irregular de la figura y no
       quede gap morado feo. El -mt controla el solape. -->
  <div class="relative z-10 mx-auto -mt-3 max-w-sm px-5 pb-14 sm:-mt-4">
    <div class="rounded-2xl bg-white p-5 shadow-xl">
      <div class="mb-2 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <img src="/masterclass/FLOR ORANGE@4x 2.svg" alt="" aria-hidden="true" class="h-6 w-6 shrink-0 select-none sm:h-7 sm:w-7" />
          <span class="text-sm font-bold text-[#EB6024] sm:text-base">Cupos disponibles</span>
        </div>
        <span class="text-sm font-bold text-[#EB6024] sm:text-base">13/20</span>
      </div>

      <div class="mb-3 h-3 w-full overflow-hidden rounded-full bg-[#A9CF38]">
        <div class="h-full rounded-full bg-[#EB6024]" style="width:65%"></div>
      </div>

      <p class="font-display text-xs leading-snug text-[#EB6024] sm:text-sm">
        Grupo pequeño para que puedas hacer preguntas directamente a Lizeth.
      </p>
    </div>
  </div>
</section>

<!-- Transición festoneada + cinta naranja (marquee) -->
<div class="relative overflow-hidden bg-[#EB6024]">

  <!-- Borde superior festoneado: nubes moradas straddlean la costura morado→naranja -->
  <img
    src="/masterclass/nubes_festoneadas_moraditas_mobile.svg"
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute left-1/2 top-0 z-10 w-full min-w-[430px] -translate-x-1/2 -translate-y-1/2 select-none"
  />

  <!-- Cinta marquee -->
  <div class="relative overflow-hidden pt-12 pb-3">
    <div class="mc-marquee-track flex items-center">
      {[0, 1].map(() => (
        <div class="mc-marquee-content flex shrink-0 items-center">
          {marqueeItems.map((item) => (
            <>
              <img src="/masterclass/ISOTIPO POSITIVO@4x 1.svg" alt="" aria-hidden="true" class="mx-6 h-9 w-9 object-contain" />
              <span class="whitespace-nowrap text-base font-black uppercase tracking-widest text-white sm:text-lg">
                {item}
              </span>
            </>
          ))}
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  @keyframes mc-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-100%); }
  }
  .mc-marquee-content {
    animation: mc-scroll 20s linear infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .mc-marquee-content { animation: none; }
  }
</style>
