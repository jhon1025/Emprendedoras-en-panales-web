---
const invitadas = [
  { nombre: 'Natalia Castillo', foto: '/Natalia_Castillo.png' },
  { nombre: 'Mari Manotas', foto: '/Mari_Manotas.png' },
  { nombre: 'Lucia Aldana', descripcion: 'Influencer conocida por ser "Hija de Dios"', foto: '/Lucia_Aldana.png' },
];
---
<section class="bg-[#E75F24] py-10 px-5 relative overflow-hidden">
  <svg class="absolute top-0 left-0 w-full" viewBox="0 0 390 32" preserveAspectRatio="none" fill="#6A3A9F">
    <path d="M0,0 Q60,32 130,18 Q200,4 260,22 Q320,36 390,12 L390,0 Z"/>
  </svg>

  <h2 class="font-bold text-4xl text-white mt-6 mb-8 font-sans leading-tight">
    Invitadas que <span class="text-[#FAED37]">inspiran</span>
  </h2>

  <div class="space-y-6">
    {invitadas.map((inv) => (
      <div class="bg-white rounded-2xl overflow-hidden shadow-lg">
        <img
          src={inv.foto}
          alt={inv.nombre}
          class="w-full h-72 object-cover object-top mix-blend-multiply"
        />
        <div class="px-4 py-4 bg-white">
          <h3 class="font-bold text-lg text-black font-sans">{inv.nombre}</h3>
          {inv.descripcion && (
            <p class="text-gray-500 text-sm font-display mt-1">{inv.descripcion}</p>
          )}
        </div>
      </div>
    ))}
  </div>
</section>
