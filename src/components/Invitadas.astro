---
const invitadas = [
  { nombre: 'Lucia Aldana', descripcion: '"Mi mejor corona es ser hija de Dios"', foto: '/Lucia_Aldana.png', posicion: 'object-bottom',   nube: '/nubemorada.png', tamanoNube: 'w-72 h-72', topNube: '-top-12', leftNube: 'left-[57%] -translate-x-1/2' },
  { nombre: 'Mari Manotas', foto: '/Mari_Manotas.png', posicion: 'object-bottom', nube: '/nubenaranja.png', tamanoNube: 'w-72 h-72', topNube: '-top-16', leftNube: 'left-1/2 -translate-x-1/2' },
  { nombre: 'Natalia Castillo', foto: '/Natalia_Castillo.png', posicion: 'object-bottom', nube: '/nuberosada.png', tamanoNube: 'w-72 h-72', topNube: '-top-12', leftNube: 'left-1/2 -translate-x-1/2' },
];
---
<section class="bg-[#E75F24] py-10 px-5 relative overflow-hidden lg:px-16 lg:pt-28 lg:pb-44">

<!-- Línea verde decorativa izquierda -->
  <img
    src="/lineaverde.png"
    alt=""
    aria-hidden="true"
    class="absolute left-1/2 -translate-x-1/2 top-1/2 -translate-y-1/2 h-full w-auto object-contain pointer-events-none z-0"
  />

  <!-- Estrella blanca derecha (sobre Natalia) -->
  <img
    src="/estrellablanca.png"
    alt=""
    aria-hidden="true"
    class="absolute top-8 right-4 w-16 h-16 object-contain z-10 lg:w-[18%] lg:h-auto lg:top-[10%] lg:right-[12%]"
  />

  <!-- Estrella blanca izquierda (sobre Lucía) -->
  <img
    src="/estrellablanca.png"
    alt=""
    aria-hidden="true"
    class="hidden lg:block absolute w-[18%] h-auto object-contain z-10 lg:top-[65%] lg:left-[12%]"
  />

  <h2 class="font-bold text-4xl text-white mb-8 font-sans leading-tight relative z-10 lg:text-center lg:text-5xl lg:mb-12">
    Invitadas que<br /><span class="text-[#FAED37]">inspiran</span>
  </h2>

  <!-- Móvil: columna | Desktop: 3 en fila -->
  <div class="space-y-6 relative z-10 lg:space-y-0 lg:grid lg:grid-cols-3 lg:gap-8 lg:max-w-4xl lg:mx-auto">
    {invitadas.map((inv) => (
      <div class="bg-white rounded-2xl overflow-hidden shadow-lg">
        <div class="relative aspect-[3/4]">
          <img
            src={inv.nube}
            alt=""
            aria-hidden="true"
            class={`absolute object-contain mix-blend-multiply z-0 ${inv.tamanoNube} ${inv.topNube} ${inv.leftNube}`}
          />
          <img
            src={inv.foto}
            alt={inv.nombre}
            class={`absolute inset-0 w-full h-full object-cover z-10 ${inv.posicion}`}
          />
          <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-pink-400 to-transparent z-20 pointer-events-none"></div>
          <div class="absolute bottom-8 left-4 z-30 px-4 py-3">
            <h3 class="font-bold text-2xl text-white font-sans drop-shadow-md">{inv.nombre}</h3>
            {inv.descripcion && (
              <p class="text-white/90 text-sm font-display drop-shadow-md">{inv.descripcion}</p>
            )}
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Onda inferior -->
  <div class="absolute bottom-0 left-0 w-full overflow-hidden leading-none z-10">
    <svg viewBox="0 0 1440 120" preserveAspectRatio="none" class="w-full h-20 lg:h-32" fill="white">
      <path d="M0,120 L1440,120 L1440,80 C1080,-20 360,140 0,80 Z"/>
    </svg>
  </div>

  <!-- Botón desktop -->
  <div class="hidden lg:flex justify-center mt-10 relative z-10">
    <a
      href="#"
      class="inline-block bg-[#A9CF38] text-black font-bold py-3 px-10 rounded-full font-display tracking-wide text-sm hover:bg-[#FAED37] transition-colors"
    >
      Cuéntanos tu historia
    </a>
  </div>
</section>
