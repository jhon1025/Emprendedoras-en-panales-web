---
---

<section class="relative bg-[#945DA7]" style="overflow-x: clip; overflow-y: visible;">

  <!-- ===== MÓVIL ===== -->
  <div class="block lg:hidden relative" style="min-height: 900px; padding: 24px 0 180px 0;">

    <!-- Micrófono decorativo — izquierda de carta 98 -->
    <img src="/microfono_verde.png" alt="" aria-hidden="true"
         class="absolute z-20" style="top: 30px; left: calc(6% + 50px); width: 104px;" />

    <!-- Carta 98% — derecha, inclinada derecha -->
    <div class="absolute rotate-[8deg] bg-white rounded-[20px] shadow-lg px-4 py-4 z-10 flex flex-col justify-between"
         style="top: 30px; right: 5%; width: 45vw; min-height: 96px;">
      <div class="flex items-center gap-2 mb-1">
        <img src="/headphones.png" alt="" class="w-8 h-8 shrink-0" aria-hidden="true" />
        <span class="font-display font-bold text-[#EC4699] leading-none" style="font-size: 52px;">98%</span>
      </div>
      <p class="font-sans text-[#EC4699] leading-snug" style="font-size: 15px;">
        Escuchan el <strong>episodio completo</strong>
      </p>
    </div>

    <!-- Blob naranja — izquierda de carta 98 -->
    <img src="/blob_naranja.png" alt="" aria-hidden="true"
         class="absolute z-20" style="top: 110px; left: calc(8% + 50px); width: 64px;" />

    <!-- Carta 44% — izquierda, inclinada izquierda -->
    <div class="absolute -rotate-[8deg] bg-white rounded-[20px] shadow-lg px-4 py-4 z-10 flex flex-col justify-between"
         style="top: 190px; left: 5%; width: 45vw; min-height: 96px;">
      <div class="flex items-center gap-2 mb-1">
        <img src="/local_mall.png" alt="" class="w-8 h-8 shrink-0" aria-hidden="true" />
        <span class="font-display font-bold text-[#945DA7] leading-none" style="font-size: 52px;">44%</span>
      </div>
      <p class="font-sans text-[#945DA7] leading-snug" style="font-size: 15px;">
        Han comprado un <strong>producto mencionado</strong> en el podcast.
      </p>
    </div>

    <!-- Forma rosa + blob verde + nube blanca — arriba de carta 77 -->
    <img src="/forma_pink.png" alt="" aria-hidden="true"
         class="absolute z-20" style="top: 210px; right: calc(12% + 10px); width: 64px;" />
    <img src="/nube_blanca.png" alt="" aria-hidden="true"
         class="absolute z-20" style="top: 240px; right: calc(4% + 10px); width: 80px;" />
    <img src="/blob_verde.png" alt="" aria-hidden="true"
         class="absolute z-20" style="top: 290px; right: calc(10% + 10px); width: 76px;" />

    <!-- Nube blanca — izquierda de carta 77 -->
    <img src="/nube_blanca.png" alt="" aria-hidden="true"
         class="absolute z-20" style="top: 400px; left: 16%; width: 80px;" />

    <!-- Carta 77% — derecha, inclinada derecha -->
    <div class="absolute rotate-[8deg] bg-white rounded-[20px] shadow-lg px-4 py-4 z-10 flex flex-col justify-between"
         style="top: 380px; right: 5%; width: 45vw; min-height: 96px;">
      <div class="flex items-center gap-2 mb-1">
        <img src="/cottage.png" alt="" class="w-8 h-8 shrink-0" aria-hidden="true" />
        <span class="font-display font-bold text-[#E75F24] leading-none" style="font-size: 52px;">77%</span>
      </div>
      <p class="font-sans text-[#E75F24] leading-snug" style="font-size: 15px;">
        Toman las decisiones de compra en <strong>su hogar</strong>
      </p>
    </div>


    <!-- Carta 32% — izquierda, inclinada izquierda -->
    <div class="absolute -rotate-[8deg] bg-white rounded-[20px] shadow-lg px-4 py-4 z-10 flex flex-col justify-between"
         style="top: 570px; left: 5%; width: 45vw; min-height: 96px;">
      <div class="flex items-center gap-2 mb-1">
        <img src="/storefront.png" alt="" class="w-8 h-8 shrink-0" aria-hidden="true" />
        <span class="font-display font-bold text-[#EC4699] leading-none" style="font-size: 52px;">32%</span>
      </div>
      <p class="font-sans text-[#EC4699] leading-snug" style="font-size: 15px;">
        Son dueñas de su <strong>propio negocio.</strong>
      </p>
    </div>

    <!-- Nube rosada — derecha de carta 32 -->
    <img src="/nuberosada.png" alt="" aria-hidden="true"
         class="absolute z-20" style="top: 580px; right: 5%; width: 80px;" />

    <!-- Carpeta — esquina inferior izquierda, parcialmente visible -->
    <div class="absolute rotate-[18deg] z-0" style="bottom: 20px; left: calc(-8% - 100px); width: 74%;">
      <div class="absolute inset-0 bg-[#C46BB5] rounded-tr-[28px] rounded-b-[28px] translate-x-[8px] translate-y-[8px]"></div>
      <div class="absolute -top-[32px] left-0 w-[44%] h-[36px] bg-[#F472B6] rounded-tl-[18px] rounded-tr-[18px]"></div>
      <div class="relative bg-[#F472B6] rounded-tr-[28px] rounded-b-[28px] flex items-center justify-center" style="height: 260px;">
        <img src="/ISOTIPONEGATIVO.svg" alt="" class="w-[60%] brightness-0 invert opacity-90" aria-hidden="true" />
      </div>
    </div>

  </div>

  <!-- ===== DESKTOP ===== -->
  <div class="hidden lg:block">

    <!-- CARPETA izquierda -->
    <div class="absolute left-[-3%] top-1/2 -translate-y-[50%] rotate-[16deg] z-10" style="width: 34%;">
      <div class="absolute inset-0 bg-[#C46BB5] rounded-tr-[32px] rounded-b-[32px] translate-x-[10px] translate-y-[10px]"></div>
      <div class="absolute -top-[42px] left-0 w-[44%] h-[45px] bg-[#F472B6] rounded-tl-[22px] rounded-tr-[22px]"></div>
      <div class="relative bg-[#F472B6] rounded-tr-[32px] rounded-b-[32px] flex items-center justify-center" style="height: 380px;">
        <img src="/ISOTIPONEGATIVO.svg" alt="" class="w-[62%] brightness-0 invert opacity-90" aria-hidden="true" />
      </div>
    </div>

    <!-- ÁREA DE TARJETAS -->
    <div class="relative" style="margin-left: 31%; min-height: 500px; padding: 36px 4% 36px 0;">

      <!-- Micrófono -->
      <img src="/microfono_verde.png" alt="" aria-hidden="true"
           class="absolute z-20 rotate-0" style="top: 10px; left: 27%; width: 104px;" />

      <!-- Tarjeta 32% -->
      <div class="absolute top-[60px] left-[0%] rotate-[15deg] bg-white rounded-[20px] shadow-lg px-5 py-6 z-10 flex flex-col justify-between"
           style="width: 253px; min-height: 200px;">
        <div class="flex items-center gap-2 mb-1">
          <img src="/storefront.png" alt="" class="w-9 h-9 shrink-0" aria-hidden="true" />
          <span class="font-display font-bold text-[#EC4699] leading-none" style="font-size: 80px;">32%</span>
        </div>
        <p class="font-sans text-[#EC4699] leading-snug" style="font-size: 20px;">
          Son dueñas de su <strong>propio negocio.</strong>
        </p>
      </div>

      <!-- Tarjeta 98% -->
      <div class="absolute rotate-[15deg] bg-white rounded-[20px] shadow-lg px-5 py-6 z-10 flex flex-col justify-between"
           style="width: 280px; min-height: 200px; top: -20px; left: 40%;">
        <div class="flex items-center gap-2 mb-1">
          <img src="/headphones.png" alt="" class="w-9 h-9 shrink-0" aria-hidden="true" />
          <span class="font-display font-bold text-[#EC4699] leading-none" style="font-size: 80px;">98%</span>
        </div>
        <p class="font-sans text-[#EC4699] leading-snug" style="font-size: 24px;">
          Escuchan el <strong>episodio completo</strong>
        </p>
      </div>

      <!-- Tarjeta 77% -->
      <div class="absolute -rotate-[15deg] bg-white rounded-[20px] shadow-lg px-5 py-6 z-10 flex flex-col justify-between"
           style="width: 253px; min-height: 200px; top: 250px; left: calc(2% + 250px);">
        <div class="flex items-center gap-2 mb-1">
          <img src="/cottage.png" alt="" class="w-9 h-9 shrink-0" aria-hidden="true" />
          <span class="font-display font-bold text-[#E75F24] leading-none" style="font-size: 80px;">77%</span>
        </div>
        <p class="font-sans text-[#E75F24] leading-snug" style="font-size: 20px;">
          Toman las decisiones de compra en <strong>su hogar</strong>
        </p>
      </div>

      <!-- Tarjeta 44% -->
      <div class="absolute -rotate-[15deg] bg-white rounded-[20px] shadow-lg px-5 py-6 z-10 flex flex-col justify-between"
           style="width: 280px; min-height: 200px; top: 255px; left: calc(42% + 200px);">
        <div class="flex items-center gap-2 mb-1">
          <img src="/local_mall.png" alt="" class="w-9 h-9 shrink-0" aria-hidden="true" />
          <span class="font-display font-bold text-[#945DA7] leading-none" style="font-size: 80px;">44%</span>
        </div>
        <p class="font-sans text-[#945DA7] leading-snug" style="font-size: 20px;">
          Han comprado un <strong>producto mencionado</strong> en el podcast.
        </p>
      </div>

      <!-- Decorativos desktop -->
      <img src="/blob_naranja.png" alt="" aria-hidden="true"
           class="absolute z-20" style="top: 120px; left: 30%; width: 38px;" />
      <img src="/forma_pink.png" alt="" aria-hidden="true"
           class="absolute z-20" style="top: 20px; right: calc(6% + 100px); width: 42px;" />
      <img src="/nube_blanca.png" alt="" aria-hidden="true"
           class="absolute z-20" style="top: 75px; right: calc(2% + 100px); width: 61px;" />
      <img src="/blob_verde.png" alt="" aria-hidden="true"
           class="absolute z-20" style="top: 150px; right: calc(5% + 100px); width: 55px;" />

    </div>

  </div>


</section>
