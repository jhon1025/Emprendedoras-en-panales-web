---
---
<section class="relative bg-[#945DA7] overflow-x-hidden lg:min-h-[760px]">

  <!-- Vector onda de fondo -->
  <img
    src="/vector_blog.png"
    alt=""
    class="absolute top-[60%] lg:top-1/2 -translate-y-1/2 lg:-translate-y-1/2 left-0 lg:left-0 z-0 pointer-events-none opacity-40"
    style="width: 100%; height: 600px; object-fit: fill;"
    aria-hidden="true"
  />

  <!-- Lizseth móvil -->
  <img
    src="/lizethmovilblog.png"
    alt="Lizseth Henao"
    class="lg:hidden absolute bottom-[50px] lg:bottom-[50px] left-[calc(50%+20px)] lg:left-[calc(50%+20px)] -translate-x-1/2 lg:-translate-x-1/2 w-[256px] lg:w-[256px] z-[1] pointer-events-none"
  />

  <!-- Lizseth desktop -->
  <img
    src="/blogLiszet.png"
    alt="Lizseth Henao"
    class="hidden lg:block absolute bottom-[60px] lg:bottom-[60px] left-0 lg:left-0 w-[907px] lg:w-[907px] z-10 pointer-events-none"
  />

  <!-- Decorativos desktop: zigzag derecha (ocultos en móvil) -->
  <img
    src="/flor_verde.png"
    alt=""
    class="hidden lg:block absolute top-[50px] lg:top-[50px] right-[120px] lg:right-[120px] w-[204px] lg:w-[204px] z-10 pointer-events-none"
    aria-hidden="true"
  />
  <img
    src="/estrellanaranja.png"
    alt=""
    class="hidden lg:block absolute top-[230px] lg:top-[230px] right-[210px] lg:right-[210px] w-[188px] lg:w-[188px] z-10 pointer-events-none"
    aria-hidden="true"
  />
  <img
    src="/estrellaverde.png"
    alt=""
    class="hidden lg:block absolute top-[410px] lg:top-[410px] right-[120px] lg:right-[120px] w-[156px] lg:w-[156px] z-10 pointer-events-none"
    aria-hidden="true"
  />

  <!-- Contenido -->
  <div class="relative z-20 flex flex-col items-center px-6 lg:px-6 pt-8 pb-[440px] lg:pb-0 lg:justify-center lg:text-center lg:min-h-[580px] lg:ml-[130px] lg:mr-[160px] lg:py-16">

    <div class="flex flex-col items-center lg:translate-y-[100px]">

      <!-- Botón -->
      <a
        href="#articulos"
        class="self-center bg-[#E75F24] text-white font-sans text-[13px] lg:text-[15px] px-6 lg:px-6 py-2 lg:py-2 rounded-full mb-6 lg:mb-6 inline-block hover:opacity-90 transition-opacity"
      >
        Para leer en la siesta
      </a>

      <!-- Título: izquierda en móvil, centrado en desktop -->
      <h1 class="font-display font-light text-white text-[34px] leading-[1.1] lg:text-[56px] lg:leading-[1.1] mb-5 lg:mb-5 text-center lg:text-center max-w-[320px] lg:max-w-[720px]">
        Guías de maternidad y negocio para mamás que emprenden
      </h1>

      <!-- Descripción: centrada en móvil y desktop -->
      <p class="text-white text-[13px] lg:text-[20px] leading-relaxed text-center max-w-[300px] lg:max-w-[680px]">
        Artículos escritos sin prisa, para leer sin prisa. Estrategia real en dosis que caben entre una siesta y un café recalentado.
      </p>

    </div>

    <!-- Micrófono móvil -->
    <img
      src="/microfono_blanco.png"
      alt=""
      class="self-center mt-1 lg:mt-1 mb-[20px] lg:mb-[20px] w-[80px] lg:w-[80px] rotate-[1deg] lg:rotate-[1deg] lg:hidden"
      aria-hidden="true"
    />
    <!-- Micrófono desktop -->
    <img
      src="/microfono_blanco.png"
      alt=""
      class="hidden lg:block self-center w-[184px] lg:w-[184px] rotate-[1deg] lg:rotate-[1deg] -translate-x-[20px] lg:-translate-x-[20px] translate-y-[100px] lg:translate-y-[100px]"
      aria-hidden="true"
    />

    <!-- Decorativos móvil: fila horizontal (ocultos en desktop) -->
    <div class="flex justify-center items-center gap-6 lg:gap-6 -mt-8 lg:-mt-8 lg:hidden translate-x-[20px] lg:translate-x-[20px]">
      <img src="/estrellaverde.png" alt="" class="w-[140px] lg:w-[140px] mr-[-40px] lg:mr-[-40px] translate-y-[30px] lg:translate-y-[30px]" aria-hidden="true" />
      <img src="/estrellanaranja.png" alt="" class="w-[160px] lg:w-[160px]" aria-hidden="true" />
      <img src="/flor_verde.png" alt="" class="w-[150px] lg:w-[150px] ml-[-40px] lg:ml-[-40px] -translate-x-[5px] lg:-translate-x-[5px] translate-y-[30px] lg:translate-y-[30px]" aria-hidden="true" />
    </div>

  </div>

  <!-- Onda inferior -->
  <div class="absolute bottom-0 lg:bottom-0 left-0 lg:left-0 w-full lg:w-full overflow-hidden leading-none lg:leading-none z-[5]">
    <svg viewBox="0 0 1440 100" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" class="w-full lg:w-full h-[70px] lg:h-[100px]">
      <path d="M0,70 C300,10 700,5 1000,50 C1150,70 1300,85 1440,60 L1440,100 L0,100 Z" fill="white"/>
    </svg>
  </div>

</section>
