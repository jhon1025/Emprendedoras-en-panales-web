---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Emprendedoras en Pañales — El podcast para mamás emprendedoras" description="El podcast #1 para mamás que emprenden en Latinoamérica. Estamos construyendo algo increíble para ti.">
  <main class="min-h-screen flex flex-col items-center justify-center bg-[#EB6024] px-6 py-12 text-center">

    <img
      src="/logo_emprendedoras_en_panales.svg"
      alt="Logo Emprendedoras en Pañales"
      class="w-36 sm:w-44 md:w-56 lg:w-64 mb-8 md:mb-10"
    />

    <h1 class="font-sans text-4xl sm:text-3xl md:text-5xl lg:text-6xl text-white mb-3 md:mb-4 leading-tight">
      Estamos construyendo<br/>algo increíble para ti
    </h1>

    <p class="font-display text-base sm:text-lg md:text-xl lg:text-2xl text-white/80 max-w-md md:max-w-lg mb-6 md:mb-8">
      Muy pronto tendrás una nueva experiencia. Mientras tanto, mira nuestros episodios en YouTube.
    </p>

    <a
      href="https://www.youtube.com/@EmprendedorasEnPa%C3%B1ales"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-3 bg-white text-[#EB6024] font-sans text-base sm:text-lg md:text-xl px-6 sm:px-8 py-3 sm:py-4 rounded-full hover:bg-gray-100 transition-colors"
    >
      <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
      </svg>
      Ver episodios en YouTube
    </a>

    <p class="mt-10 md:mt-12 font-display text-xs sm:text-sm text-white/50">
      &copy; 2025 Emprendedoras en Pañales. Todos los derechos reservados.
    </p>
  </main>
</Layout>
