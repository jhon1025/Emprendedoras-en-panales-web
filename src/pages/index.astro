---
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';
import HeroHome from '../components/HeroHome.astro';
import Episodios from '../components/Episodios.astro';
import Invitadas from '../components/Invitadas.astro';
import LecturasLentas from '../components/LecturasLentas.astro';
import MarcasSponsor from '../components/MarcasSponsor.astro';
import FooterHome from '../components/FooterHome.astro';
import FooterHistoria from '../components/FooterHistoria.astro';
---

<Layout title="Emprendedoras en Pañales — Podcast & Comunidad">
  <NavBar />
  <HeroHome />
  <Episodios />
  <Invitadas />
  <LecturasLentas />
  <MarcasSponsor />
  <FooterHome />
  <FooterHistoria />
</Layout>

<style>
  :global(.reveal) {
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  :global(.reveal.reveal-hidden) {
    opacity: 0;
    transform: translateY(28px);
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.reveal) {
      transition: none;
    }
  }
</style>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const targets = document.querySelectorAll<HTMLElement>('.reveal-target');

  if (targets.length && !prefersReducedMotion) {
    targets.forEach((el) => el.classList.add('reveal', 'reveal-hidden'));

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.remove('reveal-hidden');
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15, rootMargin: '0px 0px -10% 0px' }
    );

    targets.forEach((el) => observer.observe(el));
  }
</script>
